# ---------------------------------------------------------------------------
# Shared environment file for both docker-compose.yml (local build) and
# docker-compose.prod.yml (published image). Docker Compose automatically
# loads .env from this directory regardless of which file you run with -f,
# so one copy here covers both.
# ---------------------------------------------------------------------------

# Docker image tag to use.
# - docker-compose.yml defaults to "lineup:latest" (built locally) if unset
# - docker-compose.prod.yml defaults to "am385/lineup:latest" (pulled) if unset
# Leave commented to use each file's own default; uncomment to pin a specific tag/registry.
# DOCKER_IMAGE=am385/lineup:latest

# Git commit hash stamped into the build's informational version.
# Only used by docker-compose.yml (local build); ignored by docker-compose.prod.yml.
# GIT_HASH=

# Ports Lineup listens on, both inside the container and published on the host.
HTTP_PORT=8081
HTTPS_PORT=8443

# Password for the HTTPS certificate PFX file, if it has one.
# Only used by docker-compose.prod.yml, and only takes effect once you've placed
# a certificate at ./certs/lineup.pfx (see that file's volumes section).
CERT_PASSWORD=
